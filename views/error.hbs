<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Error {{error.status}} - Trial Mate</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/tailwindcss/2.2.19/tailwind.min.css" rel="stylesheet">
</head>

<body class="bg-gray-100 flex items-center justify-center min-h-screen">
    <div class="text-center">
        <h1 class="text-6xl font-bold text-gray-800 mb-4">{{error.status}}</h1>
        <h2 class="text-2xl text-gray-600 mb-8">{{message}}</h2>
        <a href="/" class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-4 rounded">
            Go to Home Page
        </a>
        {{#if error.stack}}
        <details class="mt-8 text-left max-w-2xl mx-auto">
            <summary class="cursor-pointer text-gray-500">Show Error Details</summary>
            <pre class="mt-4 p-4 bg-gray-800 text-green-400 rounded overflow-auto">{{error.stack}}</pre>
        </details>
        {{/if}}
    </div>
</body>

</html>