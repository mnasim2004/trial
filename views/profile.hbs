<!-- Dashboard Header -->
<div class="min-h-screen bg-gradient-to-br from-gray-50 to-gray-100">
   <!-- Top Navigation Bar -->
   <nav class="bg-gradient-to-r from-indigo-600 via-purple-600 to-pink-600 shadow-2xl border-b border-purple-300">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
         <div class="flex items-center justify-between h-20">
            <div class="flex items-center space-x-4">
               <a href="/" class="flex items-center space-x-3 group">
                  <div
                     class="w-12 h-12 bg-white/20 backdrop-blur-md rounded-xl flex items-center justify-center shadow-lg group-hover:scale-110 transition-transform">
                     <span class="text-white font-bold text-lg">TM</span>
                  </div>
                  <div>
                     <span class="text-2xl font-bold text-white">Trial Mate</span>
                     <p class="text-xs text-purple-100">Dashboard</p>
                  </div>
               </a>
            </div>
            <div class="flex items-center space-x-3">
               <a href="/product/searchp"
                  class="px-5 py-2.5 bg-white/20 backdrop-blur-md hover:bg-white/30 text-white rounded-xl transition-all font-semibold shadow-lg flex items-center space-x-2 border border-white/30">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                     <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                  </svg>
                  <span>Browse</span>
               </a>
               <a href="/users/logout"
                  class="px-5 py-2.5 bg-red-500/90 hover:bg-red-600 text-white rounded-xl transition-all font-semibold shadow-lg flex items-center space-x-2">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                     <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1">
                     </path>
                  </svg>
                  <span>Logout</span>
               </a>
            </div>
         </div>
      </div>
   </nav>

   <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <!-- Success/Error Messages -->
      {{#if success}}
      <div class="mb-6 bg-green-50 border-l-4 border-green-500 p-4 rounded-lg">
         <div class="flex items-center">
            <svg class="w-5 h-5 text-green-500 mr-2" fill="currentColor" viewBox="0 0 20 20">
               <path fill-rule="evenodd"
                  d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                  clip-rule="evenodd"></path>
            </svg>
            <p class="text-sm text-green-700 font-medium">{{success}}</p>
         </div>
      </div>
      {{/if}}

      {{#if error}}
      <div class="mb-6 bg-red-50 border-l-4 border-red-500 p-4 rounded-lg">
         <div class="flex items-center">
            <svg class="w-5 h-5 text-red-500 mr-2" fill="currentColor" viewBox="0 0 20 20">
               <path fill-rule="evenodd"
                  d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z"
                  clip-rule="evenodd"></path>
            </svg>
            <p class="text-sm text-red-700 font-medium">{{error}}</p>
         </div>
      </div>
      {{/if}}

      <!-- Welcome Section -->
      <div
         class="bg-gradient-to-r from-indigo-600 via-purple-600 to-pink-600 rounded-3xl shadow-2xl p-8 mb-8 text-white relative overflow-hidden">
         <div class="absolute top-0 right-0 w-64 h-64 bg-white opacity-10 rounded-full -mr-32 -mt-32 animate-pulse">
         </div>
         <div class="absolute bottom-0 left-0 w-48 h-48 bg-white opacity-10 rounded-full -ml-24 -mb-24 animate-pulse"
            style="animation-delay: 1s;"></div>
         <div class="relative z-10">
            <div class="flex flex-col md:flex-row items-center md:items-start justify-between">
               <div class="flex items-center space-x-6 mb-6 md:mb-0">
                  <div
                     class="w-28 h-28 rounded-full bg-white/20 backdrop-blur-md border-4 border-white/30 overflow-hidden shadow-2xl ring-4 ring-white/20">
                     <img src="{{imageUrl user.photoUrl}}" alt="{{user.username}}" class="w-full h-full object-cover">
                  </div>
                  <div>
                     <h1
                        class="text-5xl font-extrabold mb-2 bg-gradient-to-r from-yellow-200 to-pink-200 bg-clip-text text-transparent">
                        Welcome back, {{user.name}}!</h1>
                     <p class="text-purple-100 text-xl font-medium mb-4">@{{user.username}}</p>
                     <div class="flex flex-wrap gap-4 mt-4">
                        <div class="flex items-center space-x-2 bg-white/10 backdrop-blur-sm px-4 py-2 rounded-lg">
                           <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                              <path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z"></path>
                              <path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z"></path>
                           </svg>
                           <span class="text-purple-50 text-sm">{{user.email}}</span>
                        </div>
                        <div class="flex items-center space-x-2 bg-white/10 backdrop-blur-sm px-4 py-2 rounded-lg">
                           <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                              <path
                                 d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z">
                              </path>
                           </svg>
                           <span class="text-purple-50 text-sm">{{user.phoneNumber}}</span>
                        </div>
                     </div>
                  </div>
               </div>
               <div class="flex flex-col sm:flex-row gap-4">
                  <a href="/product/addp"
                     class="px-6 py-3.5 bg-white text-purple-600 rounded-xl font-bold hover:bg-gray-100 transition-all transform hover:scale-105 shadow-2xl flex items-center justify-center space-x-2">
                     <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                     </svg>
                     <span>Add Product</span>
                  </a>
                  <a href="/product/searchp"
                     class="px-6 py-3.5 bg-white/20 backdrop-blur-md text-white border-2 border-white/30 rounded-xl font-semibold hover:bg-white/30 transition-all flex items-center space-x-2">
                     <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                           d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                     </svg>
                     <span>Search Products</span>
                  </a>
               </div>
            </div>
         </div>
      </div>

      <!-- Stats Cards -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
         <div class="bg-white rounded-2xl shadow-lg p-6 border border-gray-100 hover:shadow-xl transition-all">
            <div class="flex items-center justify-between">
               <div>
                  <p class="text-gray-500 text-sm font-medium mb-1">My Products</p>
                  <p class="text-3xl font-bold text-gray-900">{{products.length}}</p>
               </div>
               <div
                  class="w-16 h-16 bg-gradient-to-br from-blue-500 to-blue-600 rounded-xl flex items-center justify-center">
                  <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                     <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
                  </svg>
               </div>
            </div>
         </div>
         <div class="bg-white rounded-2xl shadow-lg p-6 border border-gray-100 hover:shadow-xl transition-all">
            <div class="flex items-center justify-between">
               <div>
                  <p class="text-gray-500 text-sm font-medium mb-1">My Trials</p>
                  <p class="text-3xl font-bold text-gray-900">{{trials.length}}</p>
               </div>
               <div
                  class="w-16 h-16 bg-gradient-to-br from-green-500 to-green-600 rounded-xl flex items-center justify-center">
                  <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                     <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2">
                     </path>
                  </svg>
               </div>
            </div>
         </div>
         <div class="bg-white rounded-2xl shadow-lg p-6 border border-gray-100 hover:shadow-xl transition-all">
            <div class="flex items-center justify-between">
               <div>
                  <p class="text-gray-500 text-sm font-medium mb-1">Trial Requests</p>
                  <p class="text-3xl font-bold text-gray-900">{{trialRequests.length}}</p>
               </div>
               <div
                  class="w-16 h-16 bg-gradient-to-br from-orange-500 to-orange-600 rounded-xl flex items-center justify-center">
                  <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                     <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9">
                     </path>
                  </svg>
               </div>
            </div>
         </div>
      </div>

      <!-- Active Chats Section -->
      {{#if allUserTrials}}
      <div class="bg-white rounded-2xl shadow-lg p-6 mb-8 border border-gray-100">
         <div class="flex items-center justify-between mb-6">
            <h2 class="text-2xl font-bold text-gray-900 flex items-center space-x-2">
               <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                     d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z">
                  </path>
               </svg>
               <span>Active Chats</span>
            </h2>
         </div>
         <div class="space-y-3">
            {{#each allUserTrials}}
            {{#if this.userId}}
            {{#if this.productUserId}}
            <a href="/product/chat/{{this._id}}"
               class="block bg-gradient-to-r from-purple-50 to-white rounded-xl border border-purple-200 p-4 hover:shadow-lg transition-all">
               <div class="flex items-center justify-between">
                  <div class="flex items-center space-x-4">
                     <div class="w-12 h-12 rounded-full overflow-hidden bg-gray-200">
                        {{#ifCond this.userId._id ../user._id}}
                        <img src="{{imageUrl this.productUserId.photoUrl}}" alt="{{this.productUserId.username}}"
                           class="w-full h-full object-cover">
                        {{else}}
                        <img src="{{imageUrl this.userId.photoUrl}}" alt="{{this.userId.username}}"
                           class="w-full h-full object-cover">
                        {{/ifCond}}
                     </div>
                     <div>
                        <p class="font-semibold text-gray-900">
                           {{#ifCond this.userId._id ../user._id}}
                           {{this.productUserId.username}}
                           {{else}}
                           {{this.userId.username}}
                           {{/ifCond}}
                        </p>
                        <p class="text-sm text-gray-600">{{this.brand}} - {{this.title}}</p>
                        <p class="text-xs text-gray-500">{{this.status}}</p>
                     </div>
                  </div>
                  <div class="flex items-center space-x-2">
                     <span id="unread-{{this._id}}"
                        class="hidden px-2 py-1 bg-red-500 text-white text-xs font-bold rounded-full">0</span>
                     <svg class="w-5 h-5 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                     </svg>
                  </div>
               </div>
            </a>
            {{/if}}
            {{/if}}
            {{/each}}
         </div>
      </div>
      {{/if}}

      <!-- My Products Section -->
      <div class="bg-white rounded-2xl shadow-lg p-6 mb-8 border border-gray-100">
         <div class="flex items-center justify-between mb-6">
            <h2 class="text-2xl font-bold text-gray-900 flex items-center space-x-2">
               <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                     d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
               </svg>
               <span>My Products</span>
            </h2>
            <a href="/product/addp"
               class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg font-medium transition-all flex items-center space-x-2">
               <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
               </svg>
               <span>Add Product</span>
            </a>
         </div>
         {{#if products}}
         <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {{#each products}}
            <div
               class="bg-gradient-to-br from-gray-50 to-white rounded-xl border border-gray-200 hover:shadow-lg transition-all overflow-hidden group">
               <div class="relative h-48 bg-gray-200 overflow-hidden">
                  <img src="{{imageUrl this.photoUrl}}" alt="{{this.title}}"
                     class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-300">
                  <div class="absolute top-2 right-2">
                     <span
                        class="px-3 py-1 bg-white/90 backdrop-blur-sm rounded-full text-sm font-semibold text-gray-900 shadow-lg">
                        ₹{{this.price}}
                     </span>
                  </div>
               </div>
               <div class="p-4">
                  <h3 class="text-lg font-bold text-gray-900 mb-1">{{this.brand}}</h3>
                  <p class="text-gray-600 text-sm mb-2">{{this.title}}</p>
                  <p class="text-gray-500 text-xs mb-4 line-clamp-2">{{this.description}}</p>
                  <div class="flex items-center justify-between">
                     <span class="text-xs text-gray-500 flex items-center space-x-1">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                           <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z">
                           </path>
                           <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                        </svg>
                        <span>{{this.location}}</span>
                     </span>
                     <div class="flex items-center space-x-2">
                        <a href="/product/editp/{{this._id}}"
                           class="group px-3 py-2 bg-blue-50 hover:bg-blue-100 text-blue-600 rounded-lg transition-all flex items-center justify-center space-x-1.5 border border-blue-200 hover:border-blue-300 shadow-sm hover:shadow min-h-[36px]">
                           <svg class="w-4 h-4 group-hover:scale-110 transition-transform flex-shrink-0" fill="none"
                              stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                 d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z">
                              </path>
                           </svg>
                           <span class="text-xs font-semibold whitespace-nowrap">Edit</span>
                        </a>
                        <form action="/product/delete/{{this._id}}" method="POST" class="inline m-0"
                           onsubmit="return confirm('Are you sure you want to delete this product? This action cannot be undone.');">
                           <button type="submit"
                              class="group px-3 py-2 bg-red-50 hover:bg-red-100 text-red-600 rounded-lg transition-all flex items-center justify-center space-x-1.5 border border-red-200 hover:border-red-300 shadow-sm hover:shadow min-h-[36px]">
                              <svg class="w-4 h-4 group-hover:scale-110 transition-transform flex-shrink-0" fill="none"
                                 stroke="currentColor" viewBox="0 0 24 24">
                                 <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16">
                                 </path>
                              </svg>
                              <span class="text-xs font-semibold whitespace-nowrap">Delete</span>
                           </button>
                        </form>
                     </div>
                  </div>
               </div>
            </div>
            {{/each}}
         </div>
         {{else}}
         <div class="text-center py-12">
            <svg class="w-24 h-24 text-gray-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
               <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path>
            </svg>
            <p class="text-gray-500 text-lg mb-4">No products yet</p>
            <a href="/product/addp"
               class="inline-block px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white rounded-lg font-medium transition-all">
               Add Your First Product
            </a>
         </div>
         {{/if}}
      </div>

      <!-- My Trials Section -->
      <div class="bg-white rounded-2xl shadow-lg p-6 mb-8 border border-gray-100">
         <div class="flex items-center justify-between mb-6">
            <h2 class="text-2xl font-bold text-gray-900 flex items-center space-x-2">
               <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                     d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2">
                  </path>
               </svg>
               <span>My Trials</span>
            </h2>
         </div>
         {{#if trials}}
         <div class="space-y-4">
            {{#each trials}}
            <div
               class="bg-gradient-to-r from-green-50 to-white rounded-xl border border-green-200 p-6 hover:shadow-lg transition-all">
               <div class="flex flex-col md:flex-row gap-6">
                  <div class="flex-shrink-0">
                     <div class="w-32 h-32 rounded-xl overflow-hidden bg-gray-200">
                        <img src="{{imageUrl this.photoUrl}}" alt="{{this.title}}" class="w-full h-full object-cover">
                     </div>
                  </div>
                  <div class="flex-grow">
                     <div class="flex items-start justify-between mb-3">
                        <div>
                           <h3 class="text-xl font-bold text-gray-900 mb-1">{{this.brand}} - {{this.title}}</h3>
                           <p class="text-gray-600 text-sm mb-2">{{this.description}}</p>
                        </div>
                        <div class="flex items-center space-x-2">
                           <span
                              class="px-3 py-1 bg-green-100 text-green-800 rounded-full text-xs font-semibold uppercase">
                              {{this.status}}
                           </span>
                        </div>
                     </div>
                     <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-4">
                        <div class="flex items-center space-x-2 text-sm text-gray-600">
                           <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                 d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z">
                              </path>
                           </svg>
                           <span>{{this.dateString}}</span>
                        </div>
                        <div class="flex items-center space-x-2 text-sm text-gray-600">
                           <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                 d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                           </svg>
                           <span>{{this.timeSlot}}</span>
                        </div>
                        <div class="flex items-center space-x-2 text-sm text-gray-600">
                           <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                 d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z">
                              </path>
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                 d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                           </svg>
                           <span>{{this.location}}</span>
                        </div>
                        <div class="flex items-center space-x-2 text-sm text-gray-600">
                           <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                 d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                           </svg>
                           <span>{{this.productUserId.username}}</span>
                        </div>
                     </div>
                     <div class="flex items-center space-x-3">
                        <a href="/product/chat/{{this._id}}"
                           class="px-4 py-2 bg-purple-600 hover:bg-purple-700 text-white rounded-lg text-sm font-medium transition-all flex items-center space-x-1">
                           <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                 d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z">
                              </path>
                           </svg>
                           <span>Chat</span>
                        </a>
                        {{#ifCond this.status "Cancelled"}}
                        <span
                           class="px-4 py-2 bg-gray-400 text-white rounded-lg text-sm font-medium cursor-not-allowed">
                           Cancelled
                        </span>
                        {{else}}
                        <a href="/product/editt/{{this._id}}"
                           class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg text-sm font-medium transition-all">
                           Reschedule
                        </a>
                        <button type="button" onclick="openCancelModal('{{this._id}}')"
                           class="px-4 py-2 bg-red-600 hover:bg-red-700 text-white rounded-lg text-sm font-medium transition-all">
                           Cancel
                        </button>
                        {{/ifCond}}
                     </div>
                  </div>
               </div>
            </div>
            {{/each}}
         </div>
         {{else}}
         <div class="text-center py-12">
            <svg class="w-24 h-24 text-gray-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
               <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2">
               </path>
            </svg>
            <p class="text-gray-500 text-lg">No trials scheduled yet</p>
            <a href="/product/searchp"
               class="inline-block mt-4 px-6 py-3 bg-green-600 hover:bg-green-700 text-white rounded-lg font-medium transition-all">
               Browse Products
            </a>
         </div>
         {{/if}}
      </div>

      <!-- Trial Requests Section -->
      <div class="bg-white rounded-2xl shadow-lg p-6 mb-8 border border-gray-100">
         <div class="flex items-center justify-between mb-6">
            <h2 class="text-2xl font-bold text-gray-900 flex items-center space-x-2">
               <svg class="w-6 h-6 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                     d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9">
                  </path>
               </svg>
               <span>Trial Requests</span>
            </h2>
         </div>
         {{#if trialRequests}}
         <div class="space-y-4">
            {{#each trialRequests}}
            <div
               class="bg-gradient-to-r from-orange-50 to-white rounded-xl border border-orange-200 p-6 hover:shadow-lg transition-all">
               <div class="flex flex-col md:flex-row gap-6">
                  <div class="flex-shrink-0">
                     <div class="w-32 h-32 rounded-xl overflow-hidden bg-gray-200">
                        <img src="{{imageUrl this.photoUrl}}" alt="{{this.title}}" class="w-full h-full object-cover">
                     </div>
                  </div>
                  <div class="flex-grow">
                     <div class="flex items-start justify-between mb-3">
                        <div>
                           <h3 class="text-xl font-bold text-gray-900 mb-1">{{this.brand}} - {{this.title}}</h3>
                           <p class="text-gray-600 text-sm mb-2">{{this.description}}</p>
                        </div>
                        <div class="flex items-center space-x-2">
                           <span
                              class="px-3 py-1 bg-orange-100 text-orange-800 rounded-full text-xs font-semibold uppercase">
                              {{this.status}}
                           </span>
                        </div>
                     </div>
                     <div class="grid grid-cols-2 md:grid-cols-3 gap-4 mb-4">
                        <div class="flex items-center space-x-2 text-sm text-gray-600">
                           <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                 d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z">
                              </path>
                           </svg>
                           <span>{{this.dateString}}</span>
                        </div>
                        <div class="flex items-center space-x-2 text-sm text-gray-600">
                           <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                 d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                           </svg>
                           <span>{{this.timeSlot}}</span>
                        </div>
                        <div class="flex items-center space-x-2 text-sm text-gray-600">
                           <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                 d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z">
                              </path>
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                 d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                           </svg>
                           <span>{{this.location}}</span>
                        </div>
                     </div>
                     <div class="flex items-center justify-between">
                        <div class="flex items-center space-x-4">
                           {{#if this.userId}}
                           <div class="flex items-center space-x-2 text-sm text-gray-600">
                              <div class="w-8 h-8 rounded-full overflow-hidden bg-gray-200">
                                 <img src="{{imageUrl this.userId.photoUrl}}" alt="{{this.userId.username}}"
                                    class="w-full h-full object-cover">
                              </div>
                              <span class="font-medium">Requested by: {{this.userId.username}}</span>
                           </div>
                           {{else}}
                           <div class="text-sm text-gray-500">
                              <p>Someone requested a trial for your product</p>
                           </div>
                           {{/if}}
                        </div>
                        <div class="flex items-center space-x-3">
                           <a href="/product/chat/{{this._id}}"
                              class="px-4 py-2 bg-purple-600 hover:bg-purple-700 text-white rounded-lg text-sm font-medium transition-all flex items-center space-x-1">
                              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                 <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z">
                                 </path>
                              </svg>
                              <span>Chat</span>
                           </a>
                           {{#ifCond this.status "Pending"}}
                           <form action="/product/accept-trial/{{this._id}}" method="POST" class="inline">
                              <button type="submit"
                                 class="px-4 py-2 bg-green-600 hover:bg-green-700 text-white rounded-lg text-sm font-medium transition-all flex items-center space-x-2">
                                 <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                       d="M5 13l4 4L19 7"></path>
                                 </svg>
                                 <span>Accept</span>
                              </button>
                           </form>
                           <button type="button" onclick="openRejectModal('{{this._id}}')"
                              class="px-4 py-2 bg-red-600 hover:bg-red-700 text-white rounded-lg text-sm font-medium transition-all flex items-center space-x-2">
                              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                 <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M6 18L18 6M6 6l12 12"></path>
                              </svg>
                              <span>Reject</span>
                           </button>
                           {{/ifCond}}
                        </div>
                     </div>
                  </div>
               </div>
            </div>
            {{/each}}
         </div>
         {{else}}
         <div class="text-center py-12">
            <svg class="w-24 h-24 text-gray-300 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
               <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9">
               </path>
            </svg>
            <p class="text-gray-500 text-lg">No trial requests yet</p>
         </div>
         {{/if}}
      </div>
   </div>
</div>

<!-- Reject Modal -->
<div id="rejectModal" class="fixed inset-0 bg-black bg-opacity-50 hidden z-50 flex items-center justify-center">
   <div class="bg-white rounded-2xl shadow-2xl p-8 max-w-md w-full mx-4">
      <h3 class="text-2xl font-bold text-gray-900 mb-4">Reject Trial Request</h3>
      <p class="text-gray-600 mb-6">Please provide a reason for rejecting this trial request:</p>

      <form id="rejectForm" method="POST" class="space-y-4">
         <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">Reason</label>
            <textarea name="rejectionReason" id="rejectionReason" rows="3" required
               class="w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-red-500"
               placeholder="Enter reason for rejection..."></textarea>
         </div>

         <div class="flex space-x-4 pt-4">
            <button type="button" onclick="closeRejectModal()"
               class="flex-1 px-4 py-2 border-2 border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50 font-medium">
               Cancel
            </button>
            <button type="submit"
               class="flex-1 px-4 py-2 bg-red-600 hover:bg-red-700 text-white rounded-lg font-medium">
               Reject Trial
            </button>
         </div>
      </form>
   </div>
</div>

<!-- Cancel Modal -->
<div id="cancelModal" class="fixed inset-0 bg-black bg-opacity-50 hidden z-50 flex items-center justify-center">
   <div class="bg-white rounded-2xl shadow-2xl p-8 max-w-md w-full mx-4">
      <h3 class="text-2xl font-bold text-gray-900 mb-4">Cancel Trial</h3>
      <p class="text-gray-600 mb-6">Please provide a reason for cancelling this trial:</p>

      <form id="cancelForm" method="POST" class="space-y-4">
         <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">Reason <span
                  class="text-red-500">*</span></label>
            <select name="cancellationReason" id="cancellationReason" required
               class="w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-red-500">
               <option value="">Select a reason</option>
               <option value="Not interested anymore">Not interested anymore</option>
               <option value="Change time - need different time slot">Change time - need different time slot</option>
               <option value="Change date - need different date">Change date - need different date</option>
               <option value="Product no longer needed">Product no longer needed</option>
               <option value="Found alternative">Found alternative</option>
               <option value="Other">Other</option>
            </select>
         </div>

         <div id="otherReasonDiv" class="hidden">
            <label class="block text-sm font-medium text-gray-700 mb-2">Please specify</label>
            <textarea name="otherReason" id="otherReason" rows="3"
               class="w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-red-500"
               placeholder="Enter your reason..."></textarea>
         </div>

         <div class="flex space-x-4 pt-4">
            <button type="button" onclick="closeCancelModal()"
               class="flex-1 px-4 py-2 border-2 border-gray-300 text-gray-700 rounded-lg hover:bg-gray-50 font-medium">
               Close
            </button>
            <button type="submit"
               class="flex-1 px-4 py-2 bg-red-600 hover:bg-red-700 text-white rounded-lg font-medium">
               Cancel Trial
            </button>
         </div>
      </form>
   </div>
</div>

<script>
   function openRejectModal(trialId) {
      document.getElementById('rejectModal').classList.remove('hidden');
      document.getElementById('rejectForm').action = '/product/reject-trial/' + trialId;
   }

   function closeRejectModal() {
      document.getElementById('rejectModal').classList.add('hidden');
      document.getElementById('rejectForm').reset();
   }

   function openCancelModal(trialId) {
      document.getElementById('cancelModal').classList.remove('hidden');
      document.getElementById('cancelForm').action = '/product/tdelete/' + trialId;
   }

   function closeCancelModal() {
      document.getElementById('cancelModal').classList.add('hidden');
      document.getElementById('cancelForm').reset();
      document.getElementById('otherReasonDiv').classList.add('hidden');
   }

   // Show other reason field if "Other" is selected
   document.getElementById('cancellationReason').addEventListener('change', function () {
      if (this.value === 'Other') {
         document.getElementById('otherReasonDiv').classList.remove('hidden');
         document.getElementById('otherReason').required = true;
      } else {
         document.getElementById('otherReasonDiv').classList.add('hidden');
         document.getElementById('otherReason').required = false;
      }
   });

   // Update form submission to include other reason if needed
   document.getElementById('cancelForm').addEventListener('submit', function (e) {
      const reason = document.getElementById('cancellationReason').value;
      if (reason === 'Other') {
         const otherReason = document.getElementById('otherReason').value;
         if (!otherReason.trim()) {
            e.preventDefault();
            alert('Please specify your reason.');
            return false;
         }
         // Create hidden input with combined reason
         const hiddenInput = document.createElement('input');
         hiddenInput.type = 'hidden';
         hiddenInput.name = 'cancellationReason';
         hiddenInput.value = 'Other: ' + otherReason;
         this.appendChild(hiddenInput);
         // Remove the original reason select
         document.getElementById('cancellationReason').disabled = true;
      }
   });

   // Show unread message counts
   { { #if unreadCounts } }
   const unreadCounts = {{{ unreadCounts }}};
   Object.keys(unreadCounts).forEach(trialId => {
      const count = unreadCounts[trialId];
      if (count > 0) {
         const badge = document.getElementById('unread-' + trialId);
         if (badge) {
            badge.textContent = count > 99 ? '99+' : count;
            badge.classList.remove('hidden');
         }
      }
   });
   { {/if } }
</script>

<style>
   .line-clamp-2 {
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
   }
</style>